<Window x:Class="ExportTC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExportTC.View"
        mc:Ignorable="d"
        Title="Migrate data" Height="510" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель с кнопками меню -->
        <Grid Grid.Column="0" Background="#404040" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Height="35" Style="{StaticResource MenuButton}" HorizontalAlignment="Stretch" Click="NavigateToPathPanel">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Настройки путей"/>
                </StackPanel>
            </Button>

            <Button Height="35" Style="{StaticResource MenuButton}" Grid.Row="1" HorizontalAlignment="Stretch" Click="NavogateToExcelButton">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Данные в Excel"/>
                </StackPanel>
            </Button>

            <Button Height="35" Style="{StaticResource MenuButton}" Grid.Row="2" HorizontalAlignment="Stretch" Click="NavigateToGeneratePanel">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Формирование файла"/>
                </StackPanel>
            </Button>

            <!-- Картинка с логотипом -->
            <Image Source="/ExportTC;component/Resources/topBI.png" 
                   Grid.Row="4" 
                   Margin="0,20,0,20" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Bottom" 
                   Width="180" />
        </Grid>

        <!-- Область для сменяющегося контента -->
        <ContentControl x:Name="ContentArea" Grid.Column="1">
            <local:PathPanel></local:PathPanel>
        </ContentControl>
    </Grid>
</Window>
