<UserControl x:Class="ExportTC.View.PathPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ExportTC.View"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#F2F2F2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Label FontSize="16" FontWeight="Bold" Padding="0" Margin="5,10,5,20" Foreground="#404040">
                Задайте пути к исходным файлам
            </Label>
            <Image Source="/ExportTC;component/Resources/tooltip.png" Width="16" Height="16" Margin="5,10,0,20" ToolTip="Для успешного экспорта необходимо указать путь к BOM-файлу и Htm-файлу" />
        </StackPanel>

        <!-- Исходная директория -->
        <GroupBox Grid.Row="1" Grid.ColumnSpan="2" Margin="5,0,5,10" Padding="5" BorderBrush="#CCCCCC" Background="{DynamicResource StackBackGroundColor}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <Label Style="{StaticResource DescriptionLabel}">Исходная директория</Label>
                    <Image Source="/ExportTC;component/Resources/tooltip.png" Width="16" Height="16" Margin="5,0,0,0" ToolTip="Директория, в которой находятся BOM и Htm файлы. Файлы могут находится, как в самой папке, так и в подпапках" />
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Height="30" Margin="0,5,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                         Style="{StaticResource PathTextBox}"
                         Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                <Button Grid.Column="1" Content="Обзор" Width="75" Height="30" Margin="5,5,0,0" 
                        HorizontalAlignment="Right" Command="{Binding BrowseDirectoryCommand}" 
                        Style="{StaticResource BrowseButtonStyle}" />
            </Grid>
        </GroupBox>

        <!-- Excel-файл -->
        <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Margin="5,0,5,10" Padding="5" BorderBrush="#CCCCCC" Background="{DynamicResource StackBackGroundColor}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <Label Style="{StaticResource DescriptionLabel}">Excel-файл</Label>
                    <Image Source="/ExportTC;component/Resources/tooltip.png" Width="16" Height="16" Margin="5,0,0,0" ToolTip="BOM-файл полученный выгрузкой. Поле заполнится автоматически, если задана исходная директория и файл находится в ней" />
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Height="30" Margin="0,5,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                         Style="{StaticResource PathTextBox}"
                         Text="{Binding ExcelFilePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                <Button Grid.Column="1" Content="Обзор" Width="75" Height="30" Margin="5,5,0,0" 
                        HorizontalAlignment="Right" Command="{Binding BrowseExcelFileCommand}" 
                        Style="{StaticResource BrowseButtonStyle}" />
            </Grid>
        </GroupBox>

        <!-- Htm-файл -->
        <GroupBox Grid.Row="3" Grid.ColumnSpan="2" Margin="5,0,5,10" Padding="5" BorderBrush="#CCCCCC" Background="{DynamicResource StackBackGroundColor}">
            <GroupBox.Header>
                <StackPanel Orientation="Horizontal">
                    <Label Style="{StaticResource DescriptionLabel}">Htm-файл</Label>
                    <Image Source="/ExportTC;component/Resources/tooltip.png" Width="16" Height="16" Margin="5,0,0,0" ToolTip="Путь к HTML-файлу с названием tree.htm. Поле заполнится автоматически, если задана исходная директория и файл находится в ней" />
                </StackPanel>
            </GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Height="30" Margin="0,5,5,0" HorizontalAlignment="Stretch" VerticalAlignment="Top" 
                         Style="{StaticResource PathTextBox}"
                         Text="{Binding HtmFilePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                <Button Grid.Column="1" Content="Обзор" Width="75" Height="30" Margin="5,5,0,0" 
                        HorizontalAlignment="Right" VerticalAlignment="Top" Command="{Binding BrowseHtmFileCommand}" 
                        Style="{StaticResource BrowseButtonStyle}" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
